# Copy to `.env` and fill in. `.env` is gitignored — never commit real keys.
# All credentials are stored in secrets/ — see README or RUNNING.md for setup.

# ── logging ───────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── GDELT live poller (no key required — GDELT raw files are open) ────────
GDELT_TRANSLINGUAL=true
GDELT_POLL_LAG_SECONDS=240
GDELT_MAX_CATCHUP=16

# ── GDELT BigQuery backfill (billable — read ingest/gdelt/backfill.py) ────
# Auth via `gcloud auth application-default login`, or point this at a key file:
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
GDELT_BQ_TABLE=gdelt-bq.gdeltv2.events
BQ_MAX_SCAN_GB=50
BQ_USD_PER_TIB=6.25

# ── aisstream (vessel-safety layer) ───────────────────────────────────────
# Register at https://aisstream.io — free tier, no billing.
# The collector reads this env var FIRST, then falls back to secrets/aisstream_key.txt.
# ⚠️ Measured 2026-07-27: aisstream has NO receiver coverage in the Gulf.
# The key is valid; the data simply is not there (no terrestrial receivers).
AISSTREAM_KEY=

# ── Global Fishing Watch (satellite AIS — backtest source) ────────────────
# Token: https://globalfishingwatch.org/our-apis/tokens
# Put it here OR in secrets/gfw_token.txt (both are gitignored).
# GFW issues long JWTs — expect several hundred characters, paste it whole.
# Note: GFW has confirmed Gulf coverage but lags 4 days — backtest use only.
GFW_TOKEN=

# ── FRED (market panel — official EIA redistribution) ─────────────────────
# Register at https://fred.stlouisfed.org/docs/api/api_key.html — free.
# Put it here OR in secrets/fred_api_key.txt.
FRED_API_KEY=

# ── GNews (news supplementation — optional) ───────────────────────────────
# Register at https://gnews.io — free tier available.
# Put it here OR in secrets/gnews_api_key.txt.
GNews_API_KEY=

# ── Anthropic Claude (analyst brief — optional) ───────────────────────────
# Get a key at https://console.anthropic.com
# Put it here OR in secrets/anthropic_api_key.txt.
# Without this, GET /brief returns the grounded prompt only (dry-run mode).
ANTHROPIC_API_KEY=
